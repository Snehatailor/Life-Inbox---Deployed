# Names only. The app does not load this file. Export variables in the terminal.
# Never commit a real API key or session secret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
DATABASE_URL=sqlite:///data/life_inbox.db
LIFE_INBOX_UPLOAD_DIR=
LIFE_INBOX_SESSION_SECRET=
LIFE_INBOX_ENV=local
# Passwordless local sign-in. Unset or 1/true/yes turns it on. false/0/no turns it off.
# The student quick start sets it to false until a team wants separate inboxes.
LIFE_INBOX_ALLOW_DEV_LOGIN=1
